# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_capstone

# JWT Configuration (Change these to strong random strings in production)
JWT_ACCESS_SECRET=replace_with_strong_access_token_secret_key
JWT_REFRESH_SECRET=replace_with_strong_refresh_token_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Inventory Settings
LOW_STOCK_THRESHOLD=5

# CORS
CLIENT_URL=*
